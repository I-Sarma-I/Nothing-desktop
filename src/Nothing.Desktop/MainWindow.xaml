<Window x:Class="Nothing.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nothing.Desktop" Title="Nothing Desktop" Width="1280" Height="900" MinWidth="980" MinHeight="700" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" Loaded="WindowLoaded" Closed="WindowClosed" PreviewKeyDown="WindowKeyDown">
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
<Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="DragTitle"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="AppWordmark" Text="NOTHING DESKTOP" FontFamily="{StaticResource UiFont}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center" Margin="24,0,0,0" AutomationProperties.Name="Nothing Desktop"/>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding CanUseContent}" WindowChrome.IsHitTestVisibleInChrome="True"><RadioButton x:Name="OverviewNav" Tag="Overview" GroupName="Nav" Content="Headphone" Style="{StaticResource Tab}" IsChecked="True" Checked="Navigate"/><RadioButton x:Name="DeviceNav" Tag="Device" GroupName="Nav" Content="Device &amp; connection" Style="{StaticResource Tab}" Checked="Navigate" Margin="6,0,0,0"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"><Button x:Name="ThemeButton" IsEnabled="{Binding CanUseContent}" Style="{StaticResource CaptionButton}" Click="ThemeClick" ToolTip="{Binding ThemeToolTip}" AutomationProperties.Name="Toggle dark mode"><local:ModeIcon Mode="theme" PenBrush="{DynamicResource Ink}" Width="19" Height="19"/></Button><Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="8,0"/><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 0,5 L 11,5" Stroke="{DynamicResource Ink}" StrokeThickness="1" Width="11" Height="10"/></Button><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize" ToolTip="Maximize / Restore" AutomationProperties.Name="Maximize"><Rectangle Width="10" Height="10" Stroke="{DynamicResource Ink}" StrokeThickness="1"/></Button><Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{DynamicResource Ink}" StrokeThickness="1" Width="10" Height="10"/></Button></StackPanel>
</Grid>
<Grid Grid.Row="1" IsEnabled="{Binding CanUseContent}"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border x:Name="DeviceSidebar" Background="{DynamicResource SidebarFill}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
<Grid Margin="16,22,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="YOUR DEVICES" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" Margin="8,0,0,16"/>
<Grid Grid.Row="1"><ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding CanManageDevices}" Style="{StaticResource DeviceList}" AutomationProperties.Name="Saved devices">
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
<Path Data="M 2,12 L 2,8 C 2,1 18,1 18,8 L 18,12 M 2,10 L 5,10 L 5,18 L 2,18 Z M 15,10 L 18,10 L 18,18 L 15,18 Z" Stroke="{DynamicResource Ink}" StrokeThickness="1.4" Width="22" Height="22" VerticalAlignment="Center"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding AddressSuffix}" ToolTip="{Binding AddressText}" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,5,0,0"/></StackPanel>
<Button Grid.Column="2" Tag="{Binding}" Click="RemoveDeviceClick" Style="{StaticResource RemoveDeviceButton}" ToolTip="Remove from Nothing Desktop" AutomationProperties.Name="Remove saved device"><Path Data="M 3,5 L 15,5 M 7,2 L 11,2 M 5,5 L 6,17 L 12,17 L 13,5 M 8,8 L 8,14 M 10,8 L 10,14" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Width="18" Height="20"/></Button>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Margin="8,12" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolVisibility}}"><TextBlock Text="No saved devices" FontSize="14" FontWeight="Medium"/><TextBlock Text="Add your paired headphones to get started." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,8,0,0"/></StackPanel></Grid>
<Button x:Name="AddDeviceButton" Grid.Row="2" Content="+  Add device" Click="AddDeviceClick" IsEnabled="{Binding CanManageDevices}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,20,0,0"/>
<TextBlock Grid.Row="3" Text="Saved here. Paired in Windows." Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="8,14,8,0"/>
</Grid></Border>
<ScrollViewer x:Name="MainScroll" Grid.Column="1" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="1180" Margin="24,14,24,28">
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Micro}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Background="Transparent" Margin="0,0,8,0"/><Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanConnect}" Click="ConnectClick" MinWidth="110"/></StackPanel></Grid>
<Border Background="{DynamicResource CardFill}" CornerRadius="14" Padding="15,11" Margin="0,0,0,16" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="12"/></Border>
<StackPanel x:Name="OverviewPage">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="238"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="ProductHero"><Grid.RowDefinitions><RowDefinition Height="174"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="Assets/Headphone.png" Stretch="Uniform" Height="190" Width="210" Margin="0,-12,0,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Grid.Row="1" x:Name="ProductName" Text="{Binding SelectedDeviceName}" FontFamily="{StaticResource UiFont}" FontSize="25" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="218" Margin="0,0,0,9"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><local:MiniBattery Level="{Binding BatteryLevel}" Charging="{Binding IsCharging}" PenBrush="{DynamicResource Green}" Width="24" Height="16" Margin="0,0,9,0"/><TextBlock Text="{Binding BatteryText}" FontSize="13" ToolTip="{Binding BatteryTooltip}"/><TextBlock Text="Charging" Style="{StaticResource Micro}" Margin="8,0,0,0" Visibility="{Binding IsCharging, Converter={StaticResource BoolVisibility}}"/></StackPanel></Grid>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Noise cancellation" Style="{StaticResource Heading}"/><UniformGrid Columns="3" Margin="0,24,0,0" IsEnabled="{Binding CanAnc}"><RadioButton x:Name="AncOn" GroupName="Anc" Tag="4" Style="{StaticResource Mode}" Click="AncClick"><TextBlock Text="On" Foreground="{DynamicResource Muted}" FontSize="12"/></RadioButton><RadioButton x:Name="AncTransparency" GroupName="Anc" Tag="7" Style="{StaticResource Mode}" Click="AncClick"><TextBlock Text="Transparency" Foreground="{DynamicResource Muted}" FontSize="12"/></RadioButton><RadioButton x:Name="AncOff" GroupName="Anc" Tag="5" Style="{StaticResource Mode}" Click="AncClick"><TextBlock Text="Off" Foreground="{DynamicResource Muted}" FontSize="12"/></RadioButton></UniformGrid><Grid x:Name="AncLevelRow" Margin="0,18,0,0" Visibility="{Binding ShowAncLevel, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Level" Style="{StaticResource Micro}" VerticalAlignment="Center"/><ComboBox x:Name="AncLevel" Grid.Column="1" IsEnabled="{Binding CanAncLevel}" SelectionChanged="AncLevelChanged" AutomationProperties.Name="Cancellation level"><ComboBoxItem Content="Adaptive" Tag="4"/><ComboBoxItem Content="High" Tag="1"/><ComboBoxItem Content="Mid" Tag="2"/><ComboBoxItem Content="Low" Tag="3"/></ComboBox></Grid></StackPanel></Border>
<StackPanel Grid.Row="2">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Spatial audio" Style="{StaticResource Heading}"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SpatialText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><local:ModeIcon Grid.Column="1" Mode="spatial" PenBrush="{DynamicResource Muted}" Width="26" Height="26"/></Grid><TextBlock Text="Managed in Nothing X" Style="{StaticResource Micro}" Margin="0,10,0,0"/></StackPanel></Border>
<Border x:Name="ExtraControlsCard" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Settings" Style="{StaticResource Heading}"/><CheckBox x:Name="LatencyCheck" Content="Low latency" IsEnabled="{Binding CanLatency}" Click="LatencyClick" Margin="0,24,0,22"/><CheckBox x:Name="DualCheck" Content="Dual connection" IsEnabled="{Binding CanDual}" Click="DualClick"/><Border Height="1" Background="{DynamicResource Line}" Margin="0,23,0,18"/><CheckBox Content="Experimental controls" IsChecked="{Binding Experimental}" FontSize="12" ToolTip="Firmware-dependent writes. Each change is checked against the headphone."/></StackPanel></Border>
</StackPanel>
<Border x:Name="EqualizerCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Equaliser" Style="{StaticResource Heading}"/><TextBlock Text="{Binding PresetText}" Style="{StaticResource Micro}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Balanced" Click="BalancedClick" IsEnabled="{Binding CanEq}" VerticalAlignment="Top"/></Grid>
<local:EqResponsePlot x:Name="ResponsePlot" Height="160" Margin="0,18,0,10" InkBrush="{DynamicResource Ink}" MutedBrush="{DynamicResource Muted}" GridBrush="{DynamicResource Line}" AccentBrush="{DynamicResource Accent}"/>
<ItemsControl x:Name="BandControls" ItemsSource="{Binding Bands}" IsEnabled="{Binding CanEditEq}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding GainText}" FontFamily="Consolas" Foreground="{DynamicResource Ink}" FontSize="12" HorizontalAlignment="Center"/><Slider Style="{StaticResource StudioSlider}" Height="92" Width="30" Orientation="Vertical" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,9" AutomationProperties.Name="{Binding Label}"/><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EqHint}" Style="{StaticResource Micro}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Reset" Click="ResetEqClick" IsEnabled="{Binding CanEditEq}" Padding="14,9" Margin="0,0,6,0"/><Button Content="Apply" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanApplyEq}" Click="ApplyEqClick" Padding="20,9"/></StackPanel></Grid>
</StackPanel></Border>
</Grid></StackPanel>
<StackPanel x:Name="DevicePage" Visibility="Collapsed">
<TextBlock Text="Device &amp; connection" FontFamily="{StaticResource UiFont}" FontSize="31" Margin="0,6,0,25"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding SelectedDeviceName}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DiscoveryText}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="About" Style="{StaticResource Heading}"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="Firmware" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Firmware}"/><TextBlock Grid.Row="1" Text="Control link" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinkText}"/><TextBlock Grid.Row="2" Text="Address" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceAddress}" FontSize="12"/><TextBlock Grid.Row="3" Text="Codec preference" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CodecText}" FontSize="12"/></Grid></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Battery" Style="{StaticResource Heading}"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="Windows" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding WindowsBatteryText}"/><TextBlock Grid.Row="1" Text="NT LINK" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProtocolBatteryText}"/><TextBlock Grid.Row="2" Text="Displayed source" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BatterySource}"/><TextBlock Grid.Row="3" Text="Updated" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastRead}"/></Grid></StackPanel></Border></Grid>
<Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="Diagnostics" Style="{StaticResource Heading}"/><Button Content="Save" Click="ExportDiagnostics" HorizontalAlignment="Right" Padding="18,8"/></Grid><TextBox Text="{Binding JournalText, Mode=OneWay}" IsReadOnly="True" Height="140" FontFamily="Consolas" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Bluetooth settings" Click="OpenBluetooth"/><Button Content="Sound settings" Click="OpenSound" Margin="10,0,0,0"/></StackPanel>
</StackPanel>
</StackPanel></ScrollViewer>
<Grid x:Name="EmptyDevicePanel" Grid.Column="1" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolVisibility}}" Margin="32" AutomationProperties.Name="No devices available">
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
<TextBlock Text="No devices available" FontSize="25" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
<TextBlock Text="Add a device to get started." Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,24"/>
<Button x:Name="EmptyAddDeviceButton" Content="+  Add device" Style="{StaticResource PrimaryButton}" Click="AddDeviceClick" IsEnabled="{Binding CanManageDevices}" HorizontalAlignment="Center"/>
</StackPanel></Grid>
</Grid>
<Grid x:Name="AddDeviceOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
<Border Width="500" MaxHeight="600" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" CornerRadius="16" Padding="28">
<StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Add a device" FontSize="24" FontWeight="Medium" VerticalAlignment="Center"/><Button x:Name="ClosePickerButton" Grid.Column="1" Click="CloseDeviceModalClick" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Close device picker"><Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="10" Height="10"/></Button></Grid>
<TextBlock Text="Select a Headphone (1) paired with this PC." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,20"/>
<TextBlock Text="{Binding PickerStatus}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<ListBox x:Name="CandidateList" ItemsSource="{Binding CandidateDevices}" SelectedItem="{Binding CandidateDevice, Mode=TwoWay}" Style="{StaticResource DeviceList}" MaxHeight="230" MinHeight="76" Visibility="{Binding HasCandidates, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Paired devices available to add"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Medium"/><TextBlock Text="{Binding AddressText}" Style="{StaticResource Micro}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border Background="{DynamicResource Raised}" CornerRadius="8" Padding="16" Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Pair your headphones in Windows Bluetooth settings, then search again. This app currently supports Headphone (1)." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
<Button Content="Open Bluetooth settings" Click="OpenBluetooth" HorizontalAlignment="Left" Background="Transparent" BorderBrush="{DynamicResource ControlLine}" Margin="0,16,0,24"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RescanDevicesButton" Content="Search again" Click="RescanDevicesClick" IsEnabled="{Binding CanScanDevices}" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="Cancel" Click="CloseDeviceModalClick" Background="Transparent" Margin="8,0"/><Button x:Name="ConfirmAddButton" Grid.Column="2" Content="Add device" Click="AddSelectedDeviceClick" IsEnabled="{Binding CanAddDevice}" Style="{StaticResource PrimaryButton}"/></Grid>
</StackPanel></Border></Grid>
<Grid x:Name="RemoveDeviceOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsRemoveOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
<Border Width="440" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" CornerRadius="16" Padding="28"><StackPanel><TextBlock Text="Remove device?" FontSize="24" FontWeight="Medium"/><TextBlock Text="{Binding RemovePrompt}" TextWrapping="Wrap" Margin="0,16,0,12"/><TextBlock Text="This only removes it from the app. Windows pairing stays intact. Removing the selected device disconnects its control link and discards any unsaved EQ draft." Style="{StaticResource Micro}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button x:Name="CancelRemoveButton" Content="Cancel" Click="CloseDeviceModalClick" Margin="0,0,8,0"/><Button x:Name="ConfirmRemoveButton" Content="Remove device" Click="ConfirmRemoveClick" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Background="Transparent"/></StackPanel></StackPanel></Border></Grid>
</Grid></Window>
